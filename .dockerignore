# Keep the build context small and the image clean.
# .venv* rather than .venv, so a second interpreter's environment is excluded
# too. A 3.11 venv alongside the default one is ~2 GB, and with a remote builder
# an un-ignored venv is uploaded before the build starts.
.venv*/
mlflow.db
__pycache__/
*.pyc
.git/
.github/
docs/
finetune/
k8s/
scripts/
tests/
mlruns/
*.md
.env
.gitignore
.dockerignore
pytest.ini
requirements-dev.txt

# eval/ is excluded except the frozen retrieval configuration, which the service reads at
# runtime to build its retriever.
eval/*
!eval/retrieval_config.json
