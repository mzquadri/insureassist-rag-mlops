# Keep the build context small and the image clean.
.venv/
__pycache__/
*.pyc
.git/
.github/
docs/
finetune/
k8s/
scripts/
tests/
mlruns/
*.md
.env
.gitignore
.dockerignore
pytest.ini
requirements-dev.txt

# eval/ is excluded except the frozen retrieval configuration, which the service reads at
# runtime to build its retriever.
eval/*
!eval/retrieval_config.json
