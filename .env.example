# Copy this file to ".env" and fill values as you progress through the phases.
# Leave blank what you don't have yet.

# --- Phase 1: RAG ---
# Port 6533 (not 6333) keeps this project isolated from any other local Qdrant.
QDRANT_URL=http://localhost:6533
QDRANT_COLLECTION=insurance_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Generation backend: "ollama" (Phase 1, easy, you already know it) or "hf" (Phase 3)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Phase 3 (Hugging Face fine-tuned model)
HF_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
LORA_ADAPTER_PATH=./finetune/adapter

# --- Phase 3: LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insureassist

# --- Phase 2/5: MLflow + GCP (fill later) ---
MLFLOW_TRACKING_URI=
GCS_BUCKET=
