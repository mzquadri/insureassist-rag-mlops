# Copy this file to ".env". Every value below has a working default in src/config.py,
# so the file is optional - it exists to make the settings visible and easy to override.

# --- Vector database ---
# Port 6533 (not 6333) keeps this project isolated from any other local Qdrant.
QDRANT_URL=http://localhost:6533
QDRANT_COLLECTION=insurance_docs

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Generation ---
# "ollama" runs a local model and is what the service uses.
# "hf" loads a Hugging Face base model, plus a LoRA adapter if one exists at
# LORA_ADAPTER_PATH. No adapter ships with this repository, so "hf" runs the base model
# unless you have trained and copied one in yourself. See finetune/README.md.
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
HF_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
LORA_ADAPTER_PATH=./finetune/adapter

# --- Retrieval ---
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100
