# Copy this file to ".env". Every value below is the default in src/config.py, so the file
# is optional: it exists to make the settings visible and easy to override.
#
# That claim used to be false. This file shipped CHUNK_SIZE=600, CHUNK_OVERLAP=100 and
# TOP_K=4 while the defaults were 800/120 and 5, and named a collection nothing else uses.
# Copying it as its own first line instructs rebuilt the index at 426 chunks instead of the
# 314 every published number was measured on, and 600/100 is specifically the superseded
# dense baseline the README shows the project moving away from. The reproduce instructions
# would then disagree with the documented results, with nothing to say why.
# tests/test_env_example.py fails if this file and src/config.py drift apart again.

# --- Vector database ---
# Port 6533 (not 6333) keeps this project isolated from any other local Qdrant.
QDRANT_URL=http://localhost:6533
QDRANT_COLLECTION=nfip_sfip

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Generation ---
# "ollama" runs a local model and is what the service uses.
# "hf" loads a Hugging Face base model, plus a LoRA adapter if one exists at
# LORA_ADAPTER_PATH. No adapter ships with this repository, so "hf" runs the base model
# unless you have trained and copied one in yourself. See archive/finetune/README.md.
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
HF_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
LORA_ADAPTER_PATH=./archive/finetune/adapter

# --- Corpus ---
# "nfip" is the real licensed corpus under data/corpus/; "sample" is the synthetic files
# in data/, kept for offline demos and fixtures.
CORPUS=nfip

# --- Retrieval ---
# FROZEN. CHUNK_SIZE, CHUNK_OVERLAP and TOP_K are the configuration every published number
# was measured at, recorded in eval/retrieval_config.json. Changing them invalidates the
# comparison with eval/reference_run.json: re-run the evaluation rather than editing the
# documented results.
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# The BGE query prefix. Queries carry it, passages do not; see the note in src/config.py.
# Set to an empty value when using a non-BGE embedder.
#
# QUOTED, and it has to be. The prefix ends in a space, and python-dotenv strips trailing
# whitespace from an unquoted value, so an unquoted line here would join the prefix to the
# question ("...passages:Who is covered?") and embed every query in a form the model was
# never trained on.
BGE_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
